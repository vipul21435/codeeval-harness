# Copy to .env and fill in as needed. .env is gitignored; never commit secrets.
#
# No secrets are required to run the harness: the default model provider is an
# offline, deterministic stub. The keys below are only read when a real
# provider is selected explicitly.

# Optional: enable a hosted model provider. Leave unset to stay fully offline.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
