# Copy to .env and fill in as needed. .env is gitignored; never commit secrets.
#
# Harness settings are read from VERIFYBENCH_* environment variables, then from
# this file (a real environment variable beats a .env entry), then from the
# defaults shown below. Empty values count as unset. codeeval/settings.py holds
# the full list with the validation rules.

# Where model-generated code runs: subprocess (default) or docker.
# VERIFYBENCH_SANDBOX_BACKEND=subprocess
# Seconds one sample may run before it is graded as timed out.
# VERIFYBENCH_SAMPLE_TIMEOUT=3.0
# Samples executed concurrently.
# VERIFYBENCH_WORKERS=4
# Image reference (tag or digest) the docker backend runs samples in.
# VERIFYBENCH_DOCKER_IMAGE=python:3.12-slim
# Directory that receives run outputs, and the SQLite results store.
# VERIFYBENCH_RESULTS_DIR=results
# VERIFYBENCH_DB_PATH=results/verifybench.sqlite
# Log record format (json or text) and the least severe level emitted.
# VERIFYBENCH_LOG_FORMAT=json
# VERIFYBENCH_LOG_LEVEL=INFO
# Seed for everything randomised (sampling, the stub provider).
# VERIFYBENCH_SEED=0

# Where completions come from: mock (offline, replays a canned file) or openai.
# VERIFYBENCH_MODEL_BACKEND=mock
# Fraction of mock completions replaced by a NotImplementedError stub (0..1).
# VERIFYBENCH_MOCK_FAILURE_RATE=0.0

# No secrets are required to run the harness: the default model backend is the
# offline, deterministic mock. The settings below are only read when
# `verifybench generate --backend openai` is asked for explicitly. Any
# OpenAI-compatible server works (set the base URL to a local one).
# VERIFYBENCH_OPENAI_BASE_URL=https://api.openai.com/v1
# VERIFYBENCH_OPENAI_MODEL=gpt-4o-mini
# VERIFYBENCH_OPENAI_API_KEY=
# VERIFYBENCH_OPENAI_TIMEOUT=60
# VERIFYBENCH_OPENAI_RETRIES=2
